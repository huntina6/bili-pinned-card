{
  "name": "@huntina6/bili-pinned-card",
  "version": "1.6.0",
  "description": "B站置顶评论监测 + 自动出图（全平台独立版，无需浏览器、无需登录，支持按评论ID出图与UP互动回顾）",
  "main": "cli.js",
  "bin": {
    "bili-pinned-card": "cli.js"
  },
  "files": [
    "cli.js",
    "lib/",
    "types.d.ts"
  ],
  "scripts": {
    "start": "node cli.js",
    "test": "node --test",
    "check": "node scripts/check-syntax.js",
    "smoke": "node scripts/smoke.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "bilibili",
    "pinned-comment",
    "card",
    "monitor",
    "cli",
    "cross-platform"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huntina6/bili-pinned-card.git"
  },
  "bugs": {
    "url": "https://github.com/huntina6/bili-pinned-card/issues"
  },
  "homepage": "https://github.com/huntina6/bili-pinned-card",
  "license": "MIT",
  "author": "huntina6",
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2"
  }
}
